PORT=3000

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/rest/v1/

# Supabase Direct PostgreSQL Connection String:
DATABASE_URL=postgres://postgres.your-project:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

# Local PostgreSQL fallback:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_hub

# Groq AI for origin-to-kazaa suggestions (server only)
GROQ_API_KEY=

# Email Delivery (SMTP) - for student invitation emails (Nodemailer)
# If not configured, invitations will run in test/simulated mode with instant preview links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ULFS2 Student Affairs" <noreply@student-os.com>

