{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-os",
  "main": "./worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "SUPABASE_SECRET_KEY",
      "DATA_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://tcwapqlphdxuqpgyrybq.supabase.co"
  },
  "triggers": { "crons": ["0 1 * * *"] }
}
